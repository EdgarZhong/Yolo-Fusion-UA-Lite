# 忽略训练产物，仅保留目录本身（models/baseline, models/formal）
# 说明：Git 不会跟踪空目录，因此使用 .gitkeep 作为占位文件保留目录结构
models/baseline/**
!models/baseline/
!models/baseline/.gitkeep
models/fusion-attention/**
!models/fusion-attention/
!models/fusion-attention/.gitkeep
models/formal/**
!models/formal/
!models/formal/.gitkeep
# 保留 formal/dualbackbone-easy-obb-formal6 模型权重存放目录及其所有内容
!models/formal/dualbackbone-easy-obb-formal6/
!models/formal/dualbackbone-easy-obb-formal6/**
# 保留 formal/fusion-attention/dualbackbone-fusionattention-obb 模型权重存放目录（该模型正在训练中）
!models/formal/fusion-attention/
!models/formal/fusion-attention/dualbackbone-fusionattention-obb/
!models/formal/fusion-attention/dualbackbone-fusionattention-obb/**